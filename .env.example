# ── Kaggle (required) ──────────────────────────────────────────────────
# KAGGLE_USERNAME is your kaggle.com profile name — NOT your email.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ── Worker identity ────────────────────────────────────────────────────
KERNEL_SLUG=ltx-video-studio
# Shared secret the worker checks on /generate and /shutdown.
JOB_TOKEN=

# ── Repo the worker code is fetched from (kernels/push takes a URL) ─────
GITHUB_OWNER=bb8654838-lgtm
GITHUB_REPO=ltx-video-studio

# ── Tunnel: pick ONE ───────────────────────────────────────────────────
# Tailscale Funnel (no egress quota — preferred for video)
TAILSCALE_AUTHKEY=
TAILSCALE_FUNNEL_HOST=          # e.g. ltx-worker.your-tailnet.ts.net
# ngrok free (1 GB/month egress ≈ 10 videos)
NGROK_AUTHTOKEN=
# Fixed public URL of the worker, once the tunnel is up
TUNNEL_URL=
